#!/usr/bin/env bash

declare -Ag g_tracks
declare -g g_title
declare -g g_filename

declare -Ag g_edited_subs
declare -Ag g_edited_ids
declare -Ag g_deleted_ids

eecho() {
  echo "$@" >&2
}

fatal() {
  echo -e "\e[31m[FATAL]\e[0m" "$@" >&2
  exit 2
}

error() {
  echo -e '\e[33m[ERROR]\e[0m' "$@" >&2
}

print_tracks() {
  echo -e "\e[1mId\tType\tLang\tDefault\tForced\tSDH\tTitle\e[0m"
  for id in "${!g_tracks[@]}"; do
    echo -e "$id\t${g_tracks["$id"]//$'\e'/$'\t'}"
  done | uniq | sort -n
}

load_file() {
  local file=$g_filename
  local raw_json raw_parsed
  raw_json=$(mkvmerge -J -i "$file")
  g_title=$(jq -r '.container.properties.title // ""' <<< "$raw_json")
  raw_parsed=$(jq -r '.tracks[] | [
    .id,
    .type,
    .properties.language // "",
    .properteis.default_track // false,
    .properties.forced_track // false,
    .properties.flag_hearing_impaired // false,
    .properties.track_name // ""
  ] | @tsv' <<< "$raw_json")
  local id type rest
  while IFS=$'\e' read -r id type rest; do
    case "$type" in
      video) type="v" ;;
      audio) type="a" ;;
      subtitles) type="s" ;;
      *) ;;
    esac
    g_tracks["$id"]="$type"$'\e'"$rest"
  done <<< "${raw_parsed//$'\t'/$'\e'}"
}

ask_for_value() {
  local ret
  read -r -p "Enter new value for $*: " ret
  if [[ -z $ret ]]; then
    return 2
  fi
  echo "$ret"
}

ask_for_bool() {
  local ret
  ret=$(ask_for_value "$* [true/false]") || return 2
  case "$ret" in
    true|false) echo "$ret";;
    *) ask_for_bool "$@"
  esac
}

ask_for_string() {
  ask_for_value "$@"
}

usage() {
  cat << EOF
usage: mkvedit [file]
EOF
}

main_menu() {
  local ans
  eecho "What do you want to do?"
  cat << EOF
[1]: Edit Title
[2]: Set title to the file name (without the extension)
[3]: Edit Tracks
EOF
  read -rp "Enter number [1-3]: "  ans
  case "$ans" in 
    1) g_title=$(ask_for_string "Title" || echo "$g_title") ;;
    2) g_title="${g_filename%.*}" ;;
    3) select_tracks_menu ;;
    "") return ;;
    *) error "'$ans' is not a valid option"
  esac

  main_menu
}

select_tracks_menu() {
  local id
  print_tracks
  read -rp "Enter id of track you want to edit: " id
  [[ -n $id ]] || return

  if [[ -n ${g_tracks["$id"]} ]]; then 
    edit_track_menu "$id"
  else 
    error "Track with id '$id' does not exist"
  fi

  select_tracks_menu
}

edit_track_menu() {
  local id=$1
  [[ -n ${g_tracks["$id"]} ]] || fatal "Track with id '$id' does not exist"

  g_edited_ids["$id"]=1

  local type lang default forced sdh title
  IFS=$'\e' read -r type lang default forced sdh title <<< "${g_tracks["$id"]}"
  eecho "Which property do you want to edit [1-5]?"
  cat >&2 << EOF
[1] Language:     $lang
[2] Default:      $default
[3] Forced:       $forced
[4] SDH           $sdh
[5] Title:        $title
EOF
  [[ $type == "s" ]] && cat >&2 << EOF
[e] [edit]
[d] [delete]
EOF
  # TODO: better separate subtitle and not subtitle
  local ans
  read -rp "Select option: " ans
  case "$ans" in 
    1) lang="$(ask_for_string "Language" || $lang)" ;;
    2) default="$(ask_for_bool "Default" || $default)" ;;
    3) forced="$(ask_for_bool "Forced" || $forced)" ;;
    4) sdh="$(ask_for_bool "SDH" || $sdh)" ;;
    5) title="$(ask_for_string "Title" || $title)" ;;
    e) edit_subtitle "$id" ;;
    d) unset "g_tracks[\"$id\"]"; g_deleted_ids["$id"]=1; return ;;
    "") return ;;
    *) error "'$ans' is not a valid option"
  esac

  g_tracks["$id"]="$type"$'\e'"$lang"$'\e'"$default"$'\e'"$forced"$'\e'"$sdh"$'\e'"$title"

  edit_track_menu "$@"
}

save_to_container() {
  local -a args
  local id type lang default forced sdh title sorted_ids ans
  args=( 
    --title "$g_title"
    -o "$g_filename.new" 
  )
  local edited_subs_ids=( "${!g_edited_subs[@]}" )
  readarray -t sorted_ids < <(for id in "${!g_tracks[@]}"; do echo "$id"; done | uniq | sort -n)

  local deleted_ids=( "${!g_deleted_ids[@]}" )
  local removed_subs=( "${edited_subs_ids[@]}" "${deleted_ids[@]}")

  [[ ${#removed_subs[@]} -gt 0 ]] && IFS="," args+=( -s "!${removed_subs[*]}" )

  for id in "${!g_edited_ids[@]}"; do 
    [[ -z "${g_edited_subs["$id"]}" ]] || continue
    [[ -n "${g_tracks["$id"]}" ]] || continue
    IFS=$'\e' read -r type lang default forced sdh title <<< "${g_tracks["$id"]}"

    args+=( 
      --language "$id:$lang"
      --track-name "$id:$title"
      --default-track-flag "$id:$($default; echo "$(( 1 - $? ))")" 
      --forced-display-flag "$id:$($forced; echo "$(( 1 - $? ))")" 
      --hearing-impaired-flag "$id:$($sdh; echo "$(( 1 - $? ))")" 
    )
  done

  args+=("$g_filename")


  for id in "${edited_subs_ids[@]}"; do
    [[ -n "${g_tracks["$id"]}" ]] || continue

    IFS=$'\e' read -r type lang default forced sdh title <<< "${g_tracks["$id"]}"

    args+=( 
      --language "0:$lang"
      --track-name "0:$title"
      --default-track-flag "0:$($default; echo "$(( 1 - $? ))")" 
      --forced-display-flag "0:$($forced; echo "$(( 1 - $? ))")" 
      --hearing-impaired-flag "0:$($sdh; echo "$(( 1 - $? ))")" 
      "${g_edited_subs["$id"]}" 
    )
  done

  local -A id_idx_mapping
  local i
  for (( i=0; i<${#edited_subs_ids[@]}; ++i )); do
    id_idx_mapping["${edited_subs_ids["$i"]}"]=$(( i + 1 ))
  done

  local order_mapping=()
  for id in "${sorted_ids[@]}"; do 
    if [[ -n ${g_deleted_ids["$id"]} ]]; then
      continue;
    fi
    if [[ -n ${id_idx_mapping["$id"]} ]]; then
      order_mapping+=("${id_idx_mapping["$id"]}:0")
    else
      order_mapping+=("0:$id")
    fi
  done

  IFS="," args+=( --track-order "${order_mapping[*]}" )

  eecho -n "mkvmerge"
  printf ' %q' "${args[@]}" >&2
  eecho

  read -rp "Do you want to execute the command? [y/N]: "  ans
  case "$ans" in
    y|Y) mkvmerge "${args[@]}";;
    *) ;;
  esac
}

edit_subtitle() {
  local id=$1
  local oldsub newsub
  oldsub=$(mktemp --suffix ".srt")
  newsub=$(mktemp --suffix ".srt")
  [[ -n "${g_tracks["$id"]}" ]] || fatal "Track with id '$id' does not exist"

  mkvextract tracks "$g_filename" "$id:$oldsub" || fatal "Unable to extract subtitle with id '$id'"
  $EDITOR "$oldsub"

  subtitler convert "$oldsub" "$newsub" || fatal "Unable to convert subtitle"

  g_edited_subs["$id"]="$newsub"
}

main () {
  g_filename=$1
  [ -f "$g_filename" ] || (usage; exit 2)
  command -v mkvmerge &>/dev/null || fatal "'mkvmerge' not found"
  command -v subtitler &>/dev/null || fatal "'subtitler' not found"

  load_file
  main_menu 

  save_to_container
}

main "$@"
